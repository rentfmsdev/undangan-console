# Database MySQL
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="undangan_console"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""

ROOT_DOMAIN="undangan.co"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_WHATSAPP="6285769306099"
NEXT_PUBLIC_ENABLE_DEV_AUTH="false"
EDIT_TOKEN_SECRET="ganti-dengan-secret-minimal-32-karakter"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Set true only after this app origin is added in Google Cloud Console.
GOOGLE_ONE_TAP_ENABLED="false"

# Docker Compose + realtime collaboration
APP_PORT="3000"
COLLAB_PORT="3011"
COLLAB_ALLOWED_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:3001"

COLLAB_REDIS_HOST="127.0.0.1"
DOCKER_COLLAB_REDIS_HOST="redis"
COLLAB_REDIS_PORT="6379"
COLLAB_REDIS_USERNAME=""
COLLAB_REDIS_PASSWORD=""
COLLAB_REDIS_DATABASE="0"
COLLAB_REDIS_TLS="false"

# Retensi publish path/subdomain. Data undangan dan asset tidak dihapus.
PUBLISH_RETENTION_DAYS="30"
PUBLISH_RETENTION_SWEEP_MINUTES="60"
