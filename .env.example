# DATABASE_URL dipakai npm lokal; DOCKER_DATABASE_URL dipakai container.
# Seluruh konfigurasi tetap berada dalam file .env yang sama.
DATABASE_URL="mysql://root@127.0.0.1:3306/undangan_console"
DOCKER_DATABASE_URL="mysql://undangan:undangan_dev_password@mysql:3306/undangan_console"
MYSQL_DATABASE="undangan_console"
MYSQL_USER="undangan"
MYSQL_PASSWORD="undangan_dev_password"
MYSQL_ROOT_PASSWORD="undangan_dev_root_password"

# Produksi: domain utama tanpa protocol dan gunakan secret acak yang panjang.
ROOT_DOMAIN="undangan.co"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_WHATSAPP="6285769306099"
NEXT_PUBLIC_ENABLE_DEV_AUTH="false"
EDIT_TOKEN_SECRET="ganti-dengan-secret-minimal-32-karakter"

# Google Auth OAuth Credentials:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Realtime collaboration. In production COLLAB_ALLOWED_ORIGIN is mandatory;
# expose the WebSocket through TLS/reverse proxy and set its public URL here.
APP_PORT="3000"
COLLAB_PORT="3001"
COLLAB_ALLOWED_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:3001"

# Optional Redis pub/sub for instant revoke/role propagation across multiple
# collaboration WebSocket instances. The editor continues using MySQL fallback
# checks when COLLAB_REDIS_HOST is empty or Redis is unavailable.
COLLAB_REDIS_HOST="127.0.0.1"
DOCKER_COLLAB_REDIS_HOST="redis"
COLLAB_REDIS_PORT="6379"
COLLAB_REDIS_USERNAME=""
COLLAB_REDIS_PASSWORD=""
COLLAB_REDIS_DATABASE="0"
COLLAB_REDIS_TLS="false"

# Retensi publish path/subdomain. Saat kedaluwarsa hanya alamat publik yang
# dilepas; draft, section, tamu, ucapan, dan asset tetap disimpan.
PUBLISH_RETENTION_DAYS="30"
PUBLISH_RETENTION_SWEEP_MINUTES="60"
